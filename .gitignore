# Android
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
local.properties
android/app/bundle-build-time.txt
*.keystore
!debug.keystore
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
android/.idea/
android/app/google-services.json

# Node / React Native
node_modules/
android/node_modules
npm-debug.log
yarn-debug.log
yarn-error.log
.yarn/
frontend/.expo/
frontend/dist/
frontend/.bundle/
*.bundle

# Environment
.env
.env.local
.env.*.local

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
.fseventsd

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# Claude Code local overrides (machine-specific)
.claude/settings.local.json

# Claude Code session control files (generated by hooks, machine-specific).
# Any dotfile dropped anywhere under .claude/ is ignored — covers every current
# and future hook marker without listing each pattern by hand.
.claude/**/.*
.claude/sessions/snapshot.md
.claude/sessions/token-log.md

# Coverage reports (gerados localmente, não versionados)
frontend/coverage/
android/build/reports/kover/

# Assets gerados pelo Metro durante build-bundle (não versionados)
android/app/src/main/res/drawable-*/src_assets_*
android/app/src/main/res/drawable-*/node_modules_*

# Coletas de métricas puxadas do celular (make metrics) — podem ter dados do aparelho
/metrics/

# Misc
*.log
*.tmp
*.bak

# Heap dumps do Gradle — a JVM grava um destes (centenas de MB) ao estourar o heap, porque
# gradle.properties liga -XX:+HeapDumpOnOutOfMemoryError. Contêm a memória inteira do build,
# incluindo o que veio de local.properties, então nunca podem entrar num commit.
*.hprof
